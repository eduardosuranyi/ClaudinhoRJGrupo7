# ─── Scraper (Nitter + Playwright) ──────────────────────────────────────
# Nada obrigatório aqui — o scraper funciona sem credenciais.
# VALENTE_DATA_DIR=./data
# VALENTE_ACCOUNTS_FILE=./accounts.txt
# VALENTE_MAX_TWEETS_PER_ACCOUNT=400
# VALENTE_RATE_LIMIT_SLEEP=2.0
# VALENTE_PAGE_SIZE=40

# ─── Pipeline ontológica ────────────────────────────────────────────────
# Caminho da pasta com CSVs/RELINTs do CompStat Rio.
# Default: ../claude_impact_lab_compstat_rio (resolvido pelo config.py)
# COMPSTAT_DATA_DIR=C:\Workspaces\dev\hackathon\claude_impact_lab_compstat_rio

# Chave Anthropic — sem ela, o LLM extractor vira um stub silencioso.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-7
# LLM_MAX_TOKENS=2048
# LLM_TEMPERATURE=0.0

# Desliga o enriquecimento LLM do Disque Denúncia (deixa só estruturado).
# ENABLE_HYBRID_DISQUE=true
