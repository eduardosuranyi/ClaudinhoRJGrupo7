# O scrapper roda via Nitter+Playwright e NÃO PRECISA de credenciais X/Twitter.
# Este arquivo só existe para overrides opcionais de configuração.

# --- Caminhos ---
# VALENTE_DATA_DIR=./data
# VALENTE_ACCOUNTS_FILE=./accounts.txt

# --- Limites globais ---
# VALENTE_MAX_TWEETS_PER_ACCOUNT=400
# VALENTE_RATE_LIMIT_SLEEP=2.0
# VALENTE_PAGE_SIZE=40
